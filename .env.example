# Required: Anthropic API key for LLM calls
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required for web search: Tavily API key (https://tavily.com — free tier available)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: LLM settings (defaults shown)
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# Optional: Research settings (defaults shown)
MAX_QUESTIONS_PER_PLAN=7
MAX_SOURCES_PER_QUESTION=3
MAX_SEARCH_RESULTS=5
MAX_PLAN_REVISIONS=2
MAX_RETRIES_PER_QUESTION=2
CONTENT_MAX_CHARS=8000

# Optional: Where to persist session checkpoints
SESSIONS_DIR=sessions
